# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# Application Environment
ENVIRONMENT=development
PORT=8000

# Database Configuration
# Local development: postgresql+psycopg://localhost/vpatient
# Production (Cloud SQL): Will be set automatically in Cloud Run
DATABASE_URL=postgresql+psycopg://localhost/vpatient

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Gemini Live API (backend proxy only)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_REASONING_MODEL=gemini-3.1-pro-preview

# TUM OIDC Authentication
OIDC_ISSUER=https://tumidp.lrz.de/idp/shibboleth
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_AUTH_URL=https://login.tum.de/idp/profile/oidc/authorize
OIDC_TOKEN_URL=https://login.tum.de/idp/profile/oidc/token
OIDC_JWKS_URL=https://login.tum.de/idp/profile/oidc/keyset
# Local development:
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
# Production:
# OIDC_REDIRECT_URI=https://virtual-patients-tum.com/auth/callback

# Application Security
APP_SECRET_KEY=generate-with-python3-c-import-secrets-print-secrets-token-urlsafe-32
REQUIRE_AUTH=false

# Frontend URL (for OIDC redirects)
# Local development:
FRONTEND_URL=http://localhost:3000
# Production:
# FRONTEND_URL=https://virtual-patients-tum.com

# VHB External Login
VHB_PASSWORD=your-vhb-password-here

